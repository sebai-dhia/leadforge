# Production settings for docker-compose.prod.yml. Copy to .env.prod on the server (never commit it) and fill in all values.
# Generate each secret with: openssl rand -hex 24

# Public address the app is served from (a DNS name pointing at the server). Caddy gets the HTTPS certificate for it.
DOMAIN=

# App database
DB_PASSWORD=
# Signs sign-in tokens (32+ characters)
JWT_SECRET=
# Admin account, created on the first start. Afterwards the admin changes the email and password on the Admin page (Settings tab).
# ADMIN_PASSWORD_RESET=true applies both again at the next start (when the password is lost); set it back to false afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false

# Shared between the backend and n8n. Put the same values in the n8n credentials
# "Header Auth account" (X-Webhook-Secret) and "Header Auth account 2" (X-Callback-Secret).
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=

# n8n: its database password, and the key that encrypts its stored API keys.
# To move the n8n you already have, use the same N8N_ENCRYPTION_KEY as in app/.env.
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=

# Telegram (optional): the bot people connect to on the Profile page (not the one used in development),
# and the admin's chat id for alerts when something breaks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google sign-in: the public OAuth client ID. Add https://DOMAIN to its authorised JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=

# Daily ceilings for all users together (0 turns one off)
CAP_SEARCHES_PER_DAY=60
CAP_DRAFTS_PER_DAY=300
CAP_ENRICH_PER_DAY=100
