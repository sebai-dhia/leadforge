# DOMAIN is the public address (for example leadforge.example.com); Caddy gets and renews its HTTPS certificate.
# For a local test, DOMAIN=localhost gives a certificate Caddy trusts only on this machine.
# Behind a proxy that already serves HTTPS, DOMAIN=:PORT serves plain HTTP on that port.
{
	# keep the visitor's address a proxy in front of Caddy reports (per-address limits on guests and logins)
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Scripts only from this site and Google sign-in (no inline script: that is what stops injected code from running).
		# Styles allow 'unsafe-inline' because Angular sets inline styles; images allow any https address (map tiles).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The API. n8n's callback reaches the backend inside Docker, not through here.
	handle /api/internal/* {
		respond 404
	}
	handle /api/* {
		reverse_proxy {$BACKEND_ADDR:backend:8081}
	}

	# The web app: unknown paths load index.html so Angular's routes work on refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
