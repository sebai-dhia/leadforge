# Copy to app/.env (git-ignored) and fill in. docker compose reads it.

# Encrypts n8n's stored credentials. Generate once (for example: openssl rand -hex 24) and never change it.
# When moving an existing n8n, use the encryptionKey from its ~/.n8n/config so its credentials stay readable.
N8N_ENCRYPTION_KEY=

# Password of n8n's own Postgres database.
N8N_DB_PASSWORD=

# Public address of n8n when deployed (for example https://n8n.example.com/). Local: http://localhost:5678/
N8N_WEBHOOK_BASE=http://localhost:5678/
# true when n8n is served over HTTPS
N8N_SECURE_COOKIE=false

# Backend (read from this file too)
# Admin email and password (12+ characters), used to create the admin on the first backend start. After that, change them on the
# Admin page (Settings tab). Set ADMIN_PASSWORD_RESET=true for one start to apply them again when the password is lost.
ADMIN_EMAIL=admin@leadforge.dev
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET=false
# Telegram bot token from @BotFather: people connect their own chat to it on the Profile page. Use a different bot
# than production: only one running backend can read a bot's messages. TELEGRAM_CHAT_ID: your chat, for admin alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# When n8n runs in Docker on this machine, it reaches the backend through this address.
PUBLIC_BASE_URL=http://host.docker.internal:8081
