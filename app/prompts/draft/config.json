{
  "name": "draft",
  "description": "First-contact message from a freelancer to a local business (WhatsApp or email, English, French or Arabic).",
  "model": "gemini-3-flash-preview",
  "thinking": {
    "thinkingLevel": "minimal"
  },
  "timeoutMs": 10000,
  "tries": 2,
  "fallbacks": [
    {
      "model": "gemini-3.1-flash-lite",
      "timeoutMs": 15000,
      "tries": 1
    },
    {
      "model": "gemini-3.5-flash-lite",
      "timeoutMs": 15000,
      "tries": 1
    }
  ],
  "temperature": 0.7,
  "maxOutputTokens": 2000,
  "delimiters": {
    "open": "<<<",
    "close": ">>>"
  },
  "languages": {
    "en": {
      "name": "English",
      "tone": "Warm, professional and plain.",
      "closings": [
        "Sincerely,",
        "Cordially,",
        "Kind regards,"
      ]
    },
    "fr": {
      "name": "French",
      "tone": "Courteous and simple, with \"vous\". Natural everyday French, not stiff.",
      "closings": [
        "Cordialement,",
        "Bien cordialement,",
        "Très cordialement,"
      ]
    },
    "ar": {
      "name": "Arabic",
      "tone": "Modern Standard Arabic, simple, polite and natural to read. No dialect.",
      "closings": [
        "مع خالص التحية،",
        "مع أطيب التحيات،",
        "مع فائق التقدير،"
      ]
    }
  },
  "channels": {
    "whatsapp": {
      "words": 65,
      "subjectWords": 0,
      "line": "CHANNEL: WhatsApp. At most {{words}} words, friendly and conversational, no subject, no formal sign-off block.",
      "example": "{{body}}"
    },
    "email": {
      "words": 100,
      "subjectWords": 8,
      "line": "CHANNEL: email. A subject of at most {{subjectWords}} words and a body of at most {{words}} words. The body ends with one of these closings alone on its last line: {{closings}}. Never write the sender's name after the closing.",
      "example": "Subject: {{subject}}\n\n{{body}}"
    }
  },
  "limits": {
    "senderName": 80,
    "headline": 160,
    "senderCity": 80,
    "about": 500,
    "offer": 600,
    "listItem": 60,
    "knowledge": 1200,
    "leadName": 120,
    "type": 60,
    "address": 160,
    "host": 80,
    "reason": 700,
    "pageFact": 160,
    "pageFacts": 450,
    "userNote": 200
  },
  "variables": {
    "system": [
      "open",
      "close"
    ],
    "user": [
      "sender",
      "business",
      "language_name",
      "language_tone",
      "channel_line",
      "example"
    ],
    "facts": [
      "value",
      "open",
      "close"
    ],
    "channels": [
      "words",
      "subjectWords",
      "subject",
      "body",
      "closings"
    ]
  }
}
